# DeclineDoctor Backend Environment Variables
# Copy this file to .env and configure your keys

# LLM Advisory Provider (Optional: deterministic fallback works if empty)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Defaults to local SQLite if unset)
# SQLite: sqlite:///./data/declinedoctor.db
# PostgreSQL: postgresql://user:password@localhost:5432/declinedoctor
DATABASE_URL=sqlite:///./data/declinedoctor.db

# Payment Provider Configuration ('mock' for demo sandbox, 'razorpay' for live gateway)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
